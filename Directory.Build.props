<Project>
  <!-- STORAGE_POLICY: bin/obj pe volumul extern cand MCSP_BUILD_ROOT e setata (scripts de dezvoltare); CI/GitHub Actions ramane pe implicit. -->
  <PropertyGroup Condition="'$(MCSP_BUILD_ROOT)' != ''">
    <McspProj>$([System.Text.RegularExpressions.Regex]::Replace('$(MSBuildProjectName)', '_[a-z0-9]+_wpftmp$', ''))</McspProj>
    <BaseIntermediateOutputPath>$(MCSP_BUILD_ROOT)/obj/$(McspProj)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MCSP_BUILD_ROOT)/bin/$(McspProj)/</BaseOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
