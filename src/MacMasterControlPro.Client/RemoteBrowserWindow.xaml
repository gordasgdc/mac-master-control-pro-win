<ui:FluentWindow x:Class="MacMasterControlPro.Client.RemoteBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:MacMasterControlPro.Client"
        Title="Explorare" Height="480" Width="520" WindowStartupLocation="CenterOwner">
    <ui:FluentWindow.Resources>
        <local:RemoteEntryIconConverter x:Key="EntryIcon" />
        <local:RemoteEntrySizeConverter x:Key="EntrySize" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </ui:FluentWindow.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" x:Name="BackButton" Content="⬅︎ Înapoi" Margin="0,0,8,0" Click="OnBackClicked" Visibility="Collapsed" />
            <TextBlock Grid.Column="1" x:Name="BreadcrumbText" FontFamily="Consolas" FontSize="11" Foreground="Gray" VerticalAlignment="Center" />
        </Grid>

        <ListBox Grid.Row="2" x:Name="EntriesList" MouseDoubleClick="OnEntryDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding IsDir, Converter={StaticResource EntryIcon}}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding Size, Converter={StaticResource EntrySize}}" Foreground="Gray" FontSize="11" Margin="8,0,0,0"
                                   Visibility="{Binding IsDir, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</ui:FluentWindow>
