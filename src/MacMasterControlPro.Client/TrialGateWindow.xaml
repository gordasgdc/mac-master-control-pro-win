<Window x:Class="MacMasterControlPro.Client.TrialGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Licență" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <StackPanel Margin="24" HorizontalAlignment="Stretch">
        <TextBlock Text="Analiza este 100% completă" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="Susține dezvoltarea cu o donație (9€, o singură dată) pentru a debloca aplicarea modificărilor."
                   TextWrapping="Wrap" TextAlignment="Center" Foreground="Gray" Margin="0,10,0,14" />
        <ui:TextBox x:Name="KeyBox" PlaceholderText="Cheie de licență" Margin="0,0,0,6" />
        <TextBlock x:Name="ErrorText" Foreground="OrangeRed" FontSize="11" Visibility="Collapsed" Margin="0,0,0,6" />
        <ui:Button x:Name="MachineIdButton" Appearance="Transparent" HorizontalAlignment="Left"
                   FontFamily="Consolas" FontSize="11" Click="OnCopyMachineId" Margin="0,0,0,14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <ui:Button Content="Donează din GDC Plugin Manager" Click="OnDonateClicked" Margin="0,0,8,0" />
            <ui:Button Content="Activează" Appearance="Primary" Click="OnActivateClicked" />
        </StackPanel>
        <ui:Button Content="Anulează" Appearance="Transparent" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnCancelClicked" />
    </StackPanel>
</Window>
