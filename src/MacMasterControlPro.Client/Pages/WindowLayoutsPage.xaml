<UserControl x:Class="MacMasterControlPro.Client.Pages.WindowLayoutsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel MaxWidth="580">
        <TextBlock Text="🪟 Layout Ferestre" FontSize="22" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,16"
                   Text="Salvează pozițiile ferestrelor unei aplicații (ex. DaVinci Resolve) ca profil — util când schimbi frecvent între configurații de monitoare." />

        <ui:CardExpander Header="Salvează layout-ul curent" IsExpanded="True" Margin="0,0,0,12">
            <StackPanel>
                <ComboBox x:Name="AppCombo" Margin="0,0,0,8" DisplayMemberPath="Item1" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="ProfileNameBox" Margin="0,0,8,0" />
                    <ui:Button Grid.Column="1" Content="Salvează" Click="OnSaveClicked" />
                </Grid>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Profile salvate" IsExpanded="True" Margin="0,0,0,12">
            <StackPanel x:Name="ProfilesPanel" />
        </ui:CardExpander>

        <TextBlock x:Name="StatusText" Foreground="Gray" FontSize="11" />
    </StackPanel>
</UserControl>
