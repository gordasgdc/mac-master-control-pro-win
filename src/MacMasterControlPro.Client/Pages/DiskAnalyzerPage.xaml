<UserControl x:Class="MacMasterControlPro.Client.Pages.DiskAnalyzerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MacMasterControlPro.Client.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,0,16">
        <TextBlock Text="📊 Analiză Disc" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="Indexare completă o singură dată — după aceea, navigarea în orice subfolder e instantă, chiar dacă navighezi în alt meniu între timp." FontSize="11" Foreground="Gray" Margin="0,0,0,16" TextWrapping="Wrap" />

        <!-- Alegere radacina (afisata doar cat timp nu exista niciun arbore incarcat) -->
        <StackPanel x:Name="RootPickerPanel">
            <TextBlock Text="Alege ce vrei să analizezi:" FontWeight="SemiBold" Margin="0,0,0,8" />
            <StackPanel x:Name="RootsList" />
        </StackPanel>

        <!-- Progres indexare completa -->
        <StackPanel x:Name="IndexingPanel" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0" />
                <TextBlock x:Name="IndexingStatusText" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="O singură trecere completă — după ce se termină, orice subfolder se deschide instant, fără rescanare." FontSize="10" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Rezultat: banner cache + breadcrumb + bara proportionala + lista -->
        <StackPanel x:Name="ResultPanel" Visibility="Collapsed">

            <Border x:Name="CacheBanner" Background="#1E2128" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="CacheBannerText" FontSize="12" Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" x:Name="CacheBannerActions">
                        <ui:ProgressRing x:Name="RescanSpinner" IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0" Visibility="Collapsed" />
                        <TextBlock x:Name="RescanningText" Text="Rescanez…" FontSize="11" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed" />
                        <ui:Button x:Name="RescanButton" Content="Re-scanează doar modificările" Click="OnRescanClicked" Margin="0,0,8,0" />
                        <ui:Button x:Name="ResetCacheButton" Content="Resetare Cache &amp; Scanare Completă" Appearance="Transparent" Click="OnResetCacheClicked" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="💽" Appearance="Transparent" Click="OnRootIconClicked" ToolTip="Înapoi la alegerea discului/folderului" Margin="0,0,4,0" />
                <StackPanel Grid.Column="1" x:Name="BreadcrumbPanel" Orientation="Horizontal" VerticalAlignment="Center" />
            </Grid>

            <Border x:Name="ProportionalBarHost" Height="28" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,12">
                <Grid x:Name="ProportionalBar" />
            </Border>

            <TextBlock x:Name="EmptyFolderText" Text="Folder gol." FontSize="12" Foreground="Gray" Visibility="Collapsed" Margin="0,0,0,8" />

            <StackPanel x:Name="EntryList" />
        </StackPanel>

        <TextBlock x:Name="DeleteErrorText" FontSize="11" Foreground="#E5484D" Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

        <controls:TerminalLogView x:Name="Log" Margin="0,10,0,0" />
    </StackPanel>
    </ScrollViewer>
</UserControl>
