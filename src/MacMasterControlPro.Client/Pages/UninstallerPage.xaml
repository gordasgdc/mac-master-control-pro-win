<UserControl x:Class="MacMasterControlPro.Client.Pages.UninstallerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:MacMasterControlPro.Client"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MacMasterControlPro.Client.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc Ro='🗑️ Dezinstalator', En='🗑️ Uninstaller', Es='🗑️ Desinstalador'}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <ui:Button Grid.Column="1" x:Name="BulkDeleteButton" Content="{loc:Loc Ro='Dezinstalează selectate', En='Uninstall selected', Es='Desinstalar seleccionadas'}"
                           Appearance="Danger" Visibility="Collapsed" Click="OnBulkDeleteClicked"
                           ToolTip="{loc:Loc Ro='Șterge complet toate aplicațiile bifate mai jos — bundle-ul + toate urmele lor, într-un singur pas.', En='Fully remove every app ticked below — the app plus all its leftovers, in one step.', Es='Elimina por completo todas las apps marcadas abajo, con todos sus restos, en un solo paso.'}" />
            </Grid>
            <ui:TextBox x:Name="SearchBox" PlaceholderText="{loc:Loc Ro='Caută aplicație…', En='Search app…', Es='Buscar app…'}" Margin="0,0,0,8" TextChanged="OnSearchChanged" />
            <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AppsPanel" />
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Column="2" x:Name="DetailsPanel">
            <TextBlock Text="{loc:Loc Ro='Alege o aplicație din listă.', En='Choose an app from the list.', Es='Elige una app de la lista.'}" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
