<UserControl x:Class="MacMasterControlPro.Client.Pages.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MacMasterControlPro.Client.Controls">
    <StackPanel MaxWidth="560">
        <TextBlock Text="🧹 Curățare &amp; RAM" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

        <ui:CardExpander Header="Cache-uri recuperabile" IsExpanded="True" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="1" x:Name="SelectAllButton" Content="Selectează tot" Margin="0,0,6,0" Click="OnSelectAllClicked" />
                    <ui:Button Grid.Column="2" Content="Rescanează" Click="OnRescanClicked" />
                </Grid>
                <StackPanel x:Name="ItemsPanel" />
                <TextBlock x:Name="SelectionText" FontSize="11" Foreground="Gray" Margin="0,8,0,10" />
                <ui:Button x:Name="DeleteButton" Content="Șterge cache-urile selectate" Appearance="Primary" Click="OnDeleteClicked" />
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Fișiere mari (Downloads/Desktop/Documents/Videos)" IsExpanded="False" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="1" Content="Scanează (&gt; 200 MB)" Click="OnScanBigFilesClicked" />
                </Grid>
                <StackPanel x:Name="BigFilesPanel" />
                <ui:Button x:Name="DeleteBigFilesButton" Content="Șterge fișierele selectate" Appearance="Danger" Margin="0,8,0,0" Click="OnDeleteBigFilesClicked" IsEnabled="False" />
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="RAM &amp; DNS" IsExpanded="True" Margin="0,0,0,12">
            <ui:Button Content="Purjare RAM + Flush DNS" Click="OnPurgeClicked" />
        </ui:CardExpander>

        <ui:CardExpander Header="Coș de reciclare" IsExpanded="True">
            <ui:Button Content="Golește Coșul de reciclare" Click="OnEmptyRecycleBinClicked" />
        </ui:CardExpander>

        <TextBlock x:Name="StatusText" Margin="0,12,0,8" Foreground="Gray" FontSize="11" />
        <controls:TerminalLogView x:Name="Log" />
    </StackPanel>
</UserControl>
