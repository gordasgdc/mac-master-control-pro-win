<UserControl x:Class="MacMasterControlPro.Client.Pages.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel MaxWidth="560">
        <TextBlock Text="🛠️ Tweak-uri Sistem" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

        <ui:CardExpander Header="Explorer &amp; Search" IsExpanded="True" Margin="0,0,0,12">
            <StackPanel>
                <ui:Button Content="Activează vizualizare avansată Explorer" Margin="0,0,0,8" Click="OnExplorerClicked" />
                <ui:Button Content="Blochează thumbs.db pe unități de rețea" Margin="0,0,0,8" Click="OnThumbsClicked" />
                <ui:Button Content="Protejează folder RAW de indexare…" Click="OnProtectFolderClicked" />
                <TextBlock x:Name="ProtectStatusText" FontSize="11" Foreground="Gray" Margin="0,6,0,0" />
            </StackPanel>
        </ui:CardExpander>

        <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="Gray" FontSize="11" />
    </StackPanel>
</UserControl>
