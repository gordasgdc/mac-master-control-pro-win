<UserControl x:Class="MacMasterControlPro.Client.Pages.LoginItemsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:MacMasterControlPro.Client"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MacMasterControlPro.Client.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc Ro='🔌 Aplicații de fundal la pornire', En='🔌 Background apps at startup', Es='🔌 Apps en segundo plano al iniciar'}" FontSize="22" FontWeight="Bold" />
            <ui:Button Grid.Column="1" Content="{loc:Loc Ro='Rescanează', En='Rescan', Es='Volver a analizar'}" Click="OnRescanClicked" />
        </Grid>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,10"
                   Text="{loc:Loc Ro='Servicii de fundal (Registry Run + Startup), fără componente Microsoft — dezactivarea e reversibilă oricând.', En='Background items (Registry Run + Startup), without Microsoft components — disabling is reversible at any time.', Es='Elementos en segundo plano (Registry Run + Startup), sin componentes de Microsoft; desactivarlos es reversible en cualquier momento.'}" />
        <ui:CardExpander Header="{loc:Loc Ro='Servicii găsite', En='Items found', Es='Elementos encontrados'}" IsExpanded="True" Margin="0,0,0,12">
            <StackPanel x:Name="ItemsPanel" />
        </ui:CardExpander>
        <TextBlock x:Name="StatusText" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
        <controls:TerminalLogView x:Name="Log" />
    </StackPanel>
</UserControl>
