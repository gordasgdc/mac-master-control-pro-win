<UserControl x:Class="MacMasterControlPro.Client.Pages.CloudPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:MacMasterControlPro.Client"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MacMasterControlPro.Client.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="☁️ Cloud Manager (Multi-Provider)" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <ui:Button Grid.Column="1" Content="{loc:Loc Ro='+ Adaugă cont', En='+ Add account', Es='+ Añadir cuenta'}" Margin="0,0,8,0" Click="OnAddClicked" />
            <ui:Button Grid.Column="2" Content="{loc:Loc Ro='Rescanează', En='Rescan', Es='Volver a analizar'}" Click="OnRescanClicked" />
        </Grid>

        <ui:CardExpander Header="{loc:Loc Ro='Locație montare', En='Mount location', Es='Ubicación de montaje'}" IsExpanded="False" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                           Text="{loc:Loc Ro='Implicit, fiecare cont montat primește o literă de disc nouă. Poți alege în schimb un folder — util pe un disc extern (Thunderbolt/USB-C), ca să nu ocupi litere de disc pe intern.', En='By default, each mounted account gets a new drive letter. You can pick a folder instead — useful on an external drive (Thunderbolt/USB-C), so you do not use drive letters on the internal one.', Es='De forma predeterminada, cada cuenta montada recibe una letra de unidad nueva. Puedes elegir una carpeta; útil en un disco externo (Thunderbolt/USB-C) para no ocupar letras del disco interno.'}" />
                <TextBlock x:Name="MountFolderText" FontSize="11" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{loc:Loc Ro='Alege folder…', En='Choose folder…', Es='Elegir carpeta…'}" Margin="0,0,8,0" Click="OnChooseMountFolderClicked" />
                    <ui:Button Content="{loc:Loc Ro='Resetează (literă de disc)', En='Reset (drive letter)', Es='Restablecer (letra de unidad)'}" Click="OnResetMountFolderClicked" />
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="1" x:Name="SelectAllButton" Content="{loc:Loc Ro='Selectează tot', En='Select all', Es='Seleccionar todo'}" Click="OnSelectAllClicked" />
        </Grid>
        <ItemsControl x:Name="RemotesList" />
        <TextBlock x:Name="EmptyText" Text="{loc:Loc Ro='Niciun cont adăugat încă.', En='No account added yet.', Es='Aún no se ha añadido ninguna cuenta.'}" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
        <TextBlock x:Name="SelectionText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,10" />
        <StackPanel Orientation="Horizontal">
            <ui:Button x:Name="MountSelectedButton" Content="{loc:Loc Ro='Montează selecția', En='Mount selection', Es='Montar la selección'}" Appearance="Primary" Margin="0,0,8,0" Click="OnMountSelectedClicked" />
            <ui:Button x:Name="UnmountSelectedButton" Content="{loc:Loc Ro='Demontează selecția', En='Unmount selection', Es='Desmontar la selección'}" Click="OnUnmountSelectedClicked" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Margin="0,12,0,8" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
        <controls:TerminalLogView x:Name="Log" />
    </StackPanel>
</UserControl>
