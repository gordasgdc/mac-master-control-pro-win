<UserControl x:Class="MacMasterControlPro.Client.Pages.DependenciesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel MaxWidth="560">
        <TextBlock Text="🧩 Dependențe &amp; Cerințe Sistem" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

        <ui:CardExpander Header="Status pachete" IsExpanded="True" Margin="0,0,0,12">
            <StackPanel>
                <ItemsControl x:Name="ItemsList" Margin="0,0,0,10" />
                <ui:Button Content="Rescanează" Margin="0,0,0,8" Click="OnRescanClicked" />
                <ui:Button x:Name="InstallButton" Content="Instalează Dependențele Lipsă" Appearance="Primary" Click="OnInstallClicked" />
            </StackPanel>
        </ui:CardExpander>

        <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="10.5" Foreground="Gray" TextWrapping="Wrap" MaxHeight="160" />
    </StackPanel>
</UserControl>
