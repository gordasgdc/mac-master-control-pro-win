<UserControl x:Class="MacMasterControlPro.Client.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:MacMasterControlPro.Client"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

        <ui:CardExpander x:Name="AppearanceCard" IsExpanded="True" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="ThemeLabel" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox x:Name="ThemeCombo" SelectionChanged="OnThemeChanged" Margin="0,0,0,12">
                    <ComboBoxItem Content="{loc:Loc Ro='Sistem', En='System', Es='Sistema'}" Tag="System" />
                    <ComboBoxItem Content="{loc:Loc Ro='Luminos', En='Light', Es='Claro'}" Tag="Light" />
                    <ComboBoxItem Content="{loc:Loc Ro='Întunecat', En='Dark', Es='Oscuro'}" Tag="Dark" />
                </ComboBox>

                <TextBlock x:Name="TextScaleLabel" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox x:Name="TextScaleCombo" SelectionChanged="OnTextScaleChanged" Margin="0,0,0,12">
                    <ComboBoxItem Content="{loc:Loc Ro='Mic', En='Small', Es='Pequeño'}" Tag="Small" />
                    <ComboBoxItem Content="Normal" Tag="Normal" />
                    <ComboBoxItem Content="{loc:Loc Ro='Mare', En='Large', Es='Grande'}" Tag="Large" />
                    <ComboBoxItem Content="{loc:Loc Ro='Foarte mare', En='Extra large', Es='Muy grande'}" Tag="XLarge" />
                </ComboBox>

                <TextBlock x:Name="LanguageLabel" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox x:Name="LanguageCombo" SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="Română" Tag="Ro" />
                    <ComboBoxItem Content="English" Tag="En" />
                    <ComboBoxItem Content="Español" Tag="Es" />
                </ComboBox>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander x:Name="ProfileCard" IsExpanded="True" Margin="0,0,0,12">
            <StackPanel>
                <ui:TextBox x:Name="NameBox" Margin="0,0,0,8" TextChanged="OnProfileChanged" />
                <ui:TextBox x:Name="EmailBox" TextChanged="OnProfileChanged" />
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander x:Name="DiagCard" IsExpanded="True" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="DiagSession" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="DiagOpenButton" Click="OnDiagOpenFolder" Margin="0,0,8,0" />
                    <ui:Button x:Name="DiagCopyButton" Click="OnDiagCopySession" Margin="0,0,8,0" />
                    <ui:Button x:Name="DiagExportButton" Click="OnDiagExport" />
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander x:Name="ConfigCard" IsExpanded="False" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="ConfigText" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ui:Button x:Name="ResetConfigButton" Click="OnResetConfigClicked" />
                <TextBlock x:Name="ResetResultText" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </ui:CardExpander>

        <ui:Button x:Name="GuideButton" Click="OnOpenGuideClicked" />
    </StackPanel>
</UserControl>
