<UserControl x:Class="MacMasterControlPro.Client.Pages.ResolveToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MacMasterControlPro.Client.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640">
            <TextBlock Text="🎬 DaVinci Resolve" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

            <ui:CardExpander Header="Notificare la final de randare" IsExpanded="True" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8"
                               Text="Primești o notificare Windows nativă când o randare din coada Resolve se termină — util când randarea durează ore." />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NotifierStatusText" Grid.Column="0" Text="Inactivă" VerticalAlignment="Center" />
                        <ui:ToggleSwitch x:Name="NotifierToggle" Grid.Column="1" Checked="OnNotifierToggled" Unchecked="OnNotifierToggled" />
                    </Grid>
                    <TextBlock x:Name="NotifierErrorText" FontSize="10.5" Foreground="Orange" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <Separator Margin="0,4,0,10" />
                    <CheckBox x:Name="EmailEnabledCheck" Content="Trimite și pe email (ajunge pe telefon)" Checked="OnEmailSettingChanged" Unchecked="OnEmailSettingChanged" Margin="0,0,0,6" />
                    <StackPanel x:Name="EmailFieldsPanel" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="Gray" Margin="0,0,0,6"
                                   Text="Recomandat: folosește o „parolă de aplicație” Gmail/Outlook, NU parola reală a contului — se salvează local, în clar." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server SMTP" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="SmtpHostBox" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="SmtpPortBox" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Email expeditor" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="UsernameBox" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Parolă aplicație" VerticalAlignment="Center" />
                            <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="AppPasswordBox" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Destinatar" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="RecipientBox" Margin="0,2" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:Button Content="Salvează" Click="OnSaveEmailSettings" Margin="0,0,6,0" />
                            <ui:Button x:Name="TestEmailButton" Content="Trimite email de test" Click="OnSendTestEmail" />
                        </StackPanel>
                        <TextBlock x:Name="EmailTestStatusText" FontSize="10.5" Foreground="Gray" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Header="Auditor Media Pool — media offline &amp; clipuri duplicate" IsExpanded="True" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8"
                               Text="Citește proiectul curent deschis în Resolve (doar citire) și semnalează clipuri offline sau duplicate." />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" x:Name="ScanButton" Content="Scanează proiectul curent" Click="OnScanClicked" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" x:Name="ScanResultText" FontSize="11" Foreground="Gray" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="ScanErrorText" FontSize="11" Foreground="Orange" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl x:Name="FlagsList" />
                    <ui:Button x:Name="DeleteSelectedButton" Content="Șterge selecția din Media Pool" Foreground="OrangeRed" Click="OnDeleteSelectedClicked" IsEnabled="False" Margin="0,8,0,0" />
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Header="Sincronizare LUT-uri &amp; Fusion între stații" IsExpanded="True" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8"
                               Text="Urcă/descarcă LUT-urile și macro-urile/șabloanele Fusion printr-un cont Cloud deja configurat. PowerGrade-urile NU sunt incluse (TODO separat)." />
                    <ItemsControl x:Name="ConfigFoldersList" Margin="0,0,0,8" />
                    <ComboBox x:Name="RemoteCombo" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="UploadRadio" Content="Urcă în Cloud" IsChecked="True" Margin="0,0,12,0" />
                        <RadioButton x:Name="DownloadRadio" Content="Descarcă din Cloud" />
                    </StackPanel>
                    <ui:Button x:Name="SyncButton" Content="Sincronizează" Click="OnSyncClicked" />
                </StackPanel>
            </ui:CardExpander>

            <controls:TerminalLogView x:Name="Log" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
