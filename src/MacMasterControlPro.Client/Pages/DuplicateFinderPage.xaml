<UserControl x:Class="MacMasterControlPro.Client.Pages.DuplicateFinderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:MacMasterControlPro.Client"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MacMasterControlPro.Client.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
        <TextBlock Text="{loc:Loc Ro='🧬 Duplicate', En='🧬 Duplicates', Es='🧬 Duplicados'}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="{loc:Loc Ro='Comparație REALĂ pe conținut (hash SHA256), nu doar nume/dată — două fișiere apar ca duplicate doar dacă sunt identice byte-cu-byte.', En='REAL content comparison (SHA-256 hash), not just name/date — two files show up as duplicates only if they are byte-for-byte identical.', Es='Comparación REAL del contenido (hash SHA-256), no solo del nombre o la fecha: dos archivos aparecen como duplicados solo si son idénticos byte a byte.'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />

        <ui:CardExpander Header="{loc:Loc Ro='Foldere de căutat', En='Folders to search', Es='Carpetas donde buscar'}" IsExpanded="True" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel x:Name="FoldersPanel" Margin="0,0,0,4" />
                <ui:Button Content="{loc:Loc Ro='+ Adaugă folder…', En='+ Add folder…', Es='+ Añadir carpeta…'}" Click="OnAddFolderClicked" HorizontalAlignment="Left" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="ScanStatusText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" x:Name="ScanButton" Content="{loc:Loc Ro='Caută duplicate', En='Find duplicates', Es='Buscar duplicados'}" Appearance="Primary" Click="OnScanClicked"
                               ToolTip="{loc:Loc Ro='Scanează folderele alese și grupează fișierele identice ca și conținut.', En='Scans the chosen folders and groups files with identical content.', Es='Analiza las carpetas elegidas y agrupa los archivos con contenido idéntico.'}" />
                </Grid>
            </StackPanel>
        </ui:CardExpander>

        <TextBlock x:Name="SummaryText" FontSize="12" Margin="0,0,0,10" />

        <StackPanel x:Name="GroupsPanel" />

        <Grid x:Name="DeleteRow" Visibility="Collapsed" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="MarkedText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            <ui:Button Grid.Column="1" x:Name="DeleteMarkedButton" Appearance="Danger" Click="OnDeleteMarkedClicked" IsEnabled="False" />
        </Grid>

        <controls:TerminalLogView x:Name="Log" />
    </StackPanel>
    </ScrollViewer>
</UserControl>
