<UserControl x:Class="MacMasterControlPro.Client.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Acasă, Studio Glass: volumele reale cu iconurile Shell, o acțiune principală, apoi ce merită verificat. Stările necunoscute rămân necunoscute. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,0,24">
            <TextBlock x:Name="TitleText" FontSize="30" FontWeight="Bold" />
            <TextBlock x:Name="TaglineText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,18" />
            <ItemsControl x:Name="VolumeCards">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,22">
                <ui:Button x:Name="DiskButton" Appearance="Primary" Content="Vezi ce ocupă spațiul" Click="OnDiskClicked" Margin="0,0,10,0" />
                <ui:Button x:Name="CleanButton" Content="Curățare" Click="OnCleanClicked" />
            </StackPanel>
            <Border CornerRadius="16" Padding="18" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Ce merită verificat" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel x:Name="Checks" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
