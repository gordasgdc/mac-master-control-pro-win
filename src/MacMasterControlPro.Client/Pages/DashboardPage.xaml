<UserControl x:Class="MacMasterControlPro.Client.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Acasă, Studio Glass: panou hero (text + acțiune + ilustrație), volumele reale cu iconurile Shell, apoi stare și acces. Stările necunoscute rămân necunoscute. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="RootGrid" MaxWidth="1180" HorizontalAlignment="Center" Margin="0,0,0,24">
            <StackPanel>
                <Border CornerRadius="24" Height="250" ClipToBounds="True" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" MinWidth="280" /></Grid.ColumnDefinitions>
                        <Grid Margin="28">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock x:Name="TitleText" FontSize="30" FontWeight="Bold" />
                            <TextBlock x:Name="TaglineText" Grid.Row="1" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock x:Name="SummaryText" Grid.Row="2" FontWeight="Medium" Margin="0,10,0,0" />
                            <StackPanel Grid.Row="4" Orientation="Horizontal">
                                <ui:Button x:Name="DiskButton" Appearance="Primary" Content="Vezi ce ocupă spațiul" Click="OnDiskClicked" Margin="0,0,10,0" />
                                <ui:Button x:Name="CleanButton" Content="Curățare" Click="OnCleanClicked" />
                            </StackPanel>
                        </Grid>
                        <Image x:Name="HeroImage" Grid.Column="1" Stretch="UniformToFill" HorizontalAlignment="Right" Visibility="Collapsed">
                            <Image.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#FF000000" Offset="0.30" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Image.OpacityMask>
                        </Image>
                    </Grid>
                </Border>
                <ItemsControl x:Name="VolumeCards" Margin="-8,12,-8,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border CornerRadius="16" Padding="18" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="CheckTitle" Text="Ce merită verificat" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <StackPanel x:Name="Checks" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Width="330" Margin="20,0,0,0" CornerRadius="16" Padding="18" VerticalAlignment="Top" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="AccessTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="AccessBody" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,12" />
                            <ui:Button x:Name="AccessButton" Click="OnAccessClicked" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
