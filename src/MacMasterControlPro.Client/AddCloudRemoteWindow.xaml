<Window x:Class="MacMasterControlPro.Client.AddCloudRemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:MacMasterControlPro.Client"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{loc:Loc Ro='Adaugă cont Cloud', En='Add cloud account', Es='Añadir cuenta en la nube'}" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="{loc:Loc Ro='Adaugă cont Cloud', En='Add cloud account', Es='Añadir cuenta en la nube'}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />
        <ui:TextBox x:Name="NameBox" PlaceholderText="{loc:Loc Ro='Nume cont (ex: drive_personal)', En='Account name (e.g. drive_personal)', Es='Nombre de la cuenta (p. ej. drive_personal)'}" Margin="0,0,0,10" />
        <ComboBox x:Name="ProviderCombo" Margin="0,0,0,10" SelectionChanged="OnProviderChanged" />
        <TextBlock x:Name="OAuthNote" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"
                   Text="{loc:Loc Ro='Se va deschide browser-ul pentru autorizare — flux standard Rclone.', En='Your browser will open for authorisation — standard rclone flow.', Es='Se abrirá el navegador para autorizar: flujo estándar de rclone.'}" />
        <StackPanel x:Name="FieldsPanel" Margin="0,0,0,10" />
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Content="{loc:Loc Ro='Anulează', En='Cancel', Es='Cancelar'}" Click="OnCancelClicked" />
            <ui:Button x:Name="CreateButton" Grid.Column="1" Content="{loc:Loc Ro='Adaugă', En='Add', Es='Añadir'}" Appearance="Primary" Click="OnCreateClicked" />
        </Grid>
    </StackPanel>
</Window>
