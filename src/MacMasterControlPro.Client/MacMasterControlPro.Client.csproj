<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Doar pentru NotifyIcon (notificare la final de randare, Nivel 2 #7) -
         nu adauga nicio dependinta noua, e parte din .NET SDK. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Permite dotnet restore/build sa rezolve TFM-ul windows si de pe
         macOS (XAML->BAML nu compileaza real decat pe Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Regula 22: binare native (BouncyCastle poate aduce dependinte
         native pe unele platforme) trebuie sa ruleze x64 explicit, nu
         "Any CPU" implicit (care ar rula ARM64 pe Windows 11 ARM). -->
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MacMasterControlPro.Client</RootNamespace>
    <AssemblyName>MacMasterControlPro</AssemblyName>
    <Version>1.10.1</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms (doar pentru NotifyIcon, Nivel 2 #7) adauga implicit
         using-uri globale pentru System.Windows.Forms care intra in conflict
         cu WPF (UserControl/Application/TextBox exista in ambele namespace-uri).
         Codul foloseste System.Windows.Forms.NotifyIcon complet calificat -
         nu are nevoie de using-ul implicit, doar il elimina pe cel ambiguu. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacMasterControlPro.Core\MacMasterControlPro.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ghidul PDF (RO/EN/ES) accesibil DIN aplicatie (Setari > Ghid). -->
    <Content Include="..\..\installer\Instructiuni_Utilizare_RO.pdf" CopyToOutputDirectory="PreserveNewest" Link="Instructiuni_Utilizare_RO.pdf" />
    <Content Include="..\..\installer\Instructiuni_Utilizare_EN.pdf" CopyToOutputDirectory="PreserveNewest" Link="Instructiuni_Utilizare_EN.pdf" />
    <Content Include="..\..\installer\Instructiuni_Utilizare_ES.pdf" CopyToOutputDirectory="PreserveNewest" Link="Instructiuni_Utilizare_ES.pdf" />
  </ItemGroup>

</Project>
