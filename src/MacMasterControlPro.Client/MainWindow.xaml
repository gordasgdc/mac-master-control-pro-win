<ui:FluentWindow x:Class="MacMasterControlPro.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Master Control Studio Pro" Height="680" Width="1000" MinWidth="820" MinHeight="520"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <!-- x:Name RootGrid (Regula 24) - tinta LayoutTransform-ului din
         ApplyTextScale() (code-behind), scaleaza uniform tot continutul. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Master Control Studio Pro" Icon="pack://application:,,,/Assets/app.ico" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: lista module (frate cu footer-ul, Regula 24 - nu
                 safeAreaInset/suprapunere) -->
            <!-- BUG REAL, gasit 2026-08-30 din screenshot-ul lui Cristi: textul din
                 sidebar (ListBoxItem/TextBlock) nu avea Foreground explicit, deci
                 mostenea culoarea din tema globala (Light/Dark, aleasa de
                 ThemeManager conform Regulii 18) - cand tema rezolvata era Light,
                 textul devenea aproape negru pe fundalul FIX intunecat (#14161A) al
                 acestui sidebar, deci invizibil. Sidebar-ul e mereu intunecat
                 (Regula 7), independent de tema aleasa pentru restul ferestrei -
                 stilurile de mai jos fixeaza foreground-ul la o culoare deschisa
                 CONSTANTA aici, nu legata de tema. Foreground-urile setate explicit
                 in cod (DependenciesItem, LicenseBadge) raman neschimbate - o
                 valoare locala are mereu prioritate peste un Style. -->
            <Grid Grid.Column="0" Background="#14161A">
                <Grid.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#EDEFF2" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#EDEFF2" />
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="ModuleList" Grid.Row="0" Margin="8"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnModuleSelected">
                    <!-- FARA IsSelected="True" aici (bug real, gasit 2026-08-30 din
                         log-ul de la Cristi): ar declansa OnModuleSelected SINCRON
                         in timpul InitializeComponent(), inainte ca PageHost (declarat
                         mai jos in acest XAML) sa fie asignat -> NullReferenceException
                         imediat la pornire. Constructorul seteaza deja explicit
                         PageHost.Content = new DashboardPage() dupa InitializeComponent(). -->
                    <ListBoxItem x:Name="ItemDashboard" Tag="Dashboard" />
                    <ListBoxItem x:Name="ItemNetwork" Tag="Network" />
                    <ListBoxItem x:Name="ItemCloud" Tag="Cloud" />
                    <ListBoxItem x:Name="ItemCleanup" Tag="Cleanup" />
                    <ListBoxItem x:Name="ItemTweaks" Tag="Tweaks" />
                    <ListBoxItem x:Name="DependenciesItem" Tag="Dependencies" />
                    <ListBoxItem x:Name="ItemSettings" Tag="Settings" />
                </ListBox>

                <!-- Sidebar Footer (Regula 12): profil, Machine ID + copy, versiune, update -->
                <Border Grid.Row="1" BorderBrush="#2B2F36" BorderThickness="0,1,0,0" Padding="12,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="ProfileNameText" FontSize="12" FontWeight="Bold" Foreground="#EDEFF2" />
                                <TextBlock x:Name="ProfileEmailText" FontSize="10.5" Foreground="Gray" />
                            </StackPanel>
                            <ui:Button x:Name="LicenseBadge" Grid.Column="1" FontSize="10.5" Padding="6,2"
                                       Appearance="Transparent" VerticalAlignment="Top" Click="OnLicenseBadgeClicked" />
                        </Grid>
                        <ui:Button x:Name="MachineIdButton" Content="Machine ID: …" FontSize="10.5" Margin="0,6,0,0"
                                   Appearance="Transparent" Padding="0" HorizontalAlignment="Left" Foreground="#EDEFF2"
                                   Click="OnCopyMachineId" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VersionText" FontSize="10.5" Foreground="Gray" VerticalAlignment="Center" />
                            <ui:Button x:Name="CheckUpdatesButton" Grid.Column="1" Content="Caută actualizări" FontSize="10.5"
                                       Appearance="Transparent" Foreground="#4EA1F5" Click="OnCheckUpdatesClicked" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Continut modul curent -->
            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="24" />
        </Grid>
    </Grid>
</ui:FluentWindow>
